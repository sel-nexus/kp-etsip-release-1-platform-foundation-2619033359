# Local only; generate a unique random signing secret for deployments.
JWT_SECRET=
# Mongo connection and database (use authenticated TLS Mongo in deployment).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kp_etsip
# Explicit browser origins, comma separated.
CORS_ORIGINS=http://localhost:5173
# Seed only in a controlled local environment.
SEED_ON_STARTUP=true
ADMIN_INITIAL_PASSWORD=
DEMO_INITIAL_PASSWORD=
